# Castela Mobile build pin.
#
# This file is the single source of truth for the GrapheneOS base. Do not edit
# it by hand: update the pin with scripts/verify-pin.sh --network, then update
# the docs and tests in the same change.
#
# The upstream stable manifest references every repository by commit hash. The
# signed annotated tag below is the only moving part we intentionally follow,
# and it resolves to the exact tag object and commit recorded here.

CASTELA_BASE_NAME="GrapheneOS"
CASTELA_BASE_BRANCH="17"
CASTELA_ANDROID_TAG="android-17.0.0_r1"

# GrapheneOS 2026110200, the stable release selected for this scaffold.
CASTELA_RELEASE_TAG="2026110200"
CASTELA_MANIFEST_TAG_REF="refs/tags/2026110200"
CASTELA_RELEASE_TAG_OBJECT="433433b931eeb4a33613a52acc545c08835e5f94"
CASTELA_RELEASE_COMMIT="abed042a17e948a9734e4c3927ce936b5648129f"

CASTELA_MANIFEST_URL="https://github.com/GrapheneOS/platform_manifest.git"
CASTELA_ALLOWED_SIGNERS_URL="https://grapheneos.org/allowed_signers"
CASTELA_ALLOWED_SIGNERS_SHA256="344f59c6f058699e63fea68e35953b341c14e3bf1fbc1256f6baa84aa2aca1d0"

# Reference target for the first private build. Other supported Pixels are
# listed in config/devices.tsv. The target is a build choice, not a claim that
# a device has been flashed or tested.
CASTELA_DEFAULT_DEVICE="tegu"
CASTELA_DEFAULT_DEVICE_NAME="Pixel 9a"
CASTELA_DEFAULT_PRODUCT="tegu-cur-user"

# Host requirements from the GrapheneOS build guide. These are deliberately
# checked by scripts/doctor.sh; they are not enforced by CI runners.
CASTELA_MIN_RAM_GIB="32"
CASTELA_MIN_DISK_GIB="236"
CASTELA_RECOMMENDED_DISK_GIB="300"

# The source tree lives inside this checkout and is ignored by git. Signing
# keys must live outside the checkout; the default follows XDG conventions.
CASTELA_SOURCE_DIR="${CASTELA_SOURCE_DIR:-$ROOT/.scratch/grapheneos}"
CASTELA_SIGNING_KEY_DIR="${CASTELA_SIGNING_KEY_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/castela-mobile/signing}"
