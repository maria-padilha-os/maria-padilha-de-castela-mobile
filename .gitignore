# Signing material must never be committed.
keys/
signing/
secrets/
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.pk8
*.der

# Vendor blobs and packet captures may be sensitive or non-redistributable.
proprietary/
vendor/
*.pcap
*.pcapng
